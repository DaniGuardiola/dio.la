{
  "compilerOptions": {
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsxImportSource": "@solidjs/web",
    "jsx": "preserve",
    "types": ["vite/client", "node", "bun-types"],
    "baseUrl": "./",
    "paths": {
      "~/*": ["./src/*"]
    },
    "ignoreDeprecations": "6.0",
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
