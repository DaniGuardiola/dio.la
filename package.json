{
  "name": "dio.la",
  "type": "module",
  "scripts": {
    "analyze:build": "bun src/scripts/analyze-build.ts",
    "gen:article-data": "bun src/scripts/generate-article-data.ts",
    "gen": "bun gen:article-data",
    "watch:article-data": "watch 'bun gen:article-data' src/content/article",
    "watch": "bun watch:article-data",
    "dev:watch": "NODE_ENV='development' bun watch",
    "dev": "concurrently --kill-others 'bun dev:watch' 'bun dev:app'",
    "typecheck": "NODE_ENV=development bun run gen && bun node_modules/@typescript/native/bin/tsc --noEmit --skipLibCheck",
    "lint": "oxlint --ignore-path .gitignore .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "build": "NODE_ENV=production bun run gen && vite build",
    "build:cloudflare": "bun run build",
    "preview:cloudflare": "vite preview --port 3000",
    "deploy:cloudflare": "bun run build && wrangler deploy --config dist/server/wrangler.json",
    "build:cloudflare:drafts": "IS_DRAFTS=true VITE_IS_DRAFTS=true bun run build",
    "preview:cloudflare:drafts": "VITE_IS_DRAFTS=true vite preview --port 3000",
    "deploy:cloudflare:drafts": "bun run build:cloudflare:drafts && wrangler deploy --config dist/server/wrangler.json",
    "start": "vite preview",
    "prod": "bun build && bun start",
    "deploy:cloudflare:redirects": "wrangler deploy --config cloudflare/redirects/wrangler.jsonc",
    "dev:app": "vite dev --port 3000"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@solidjs/web": "2.0.0-rc.13",
    "@tanstack/solid-router": "2.0.0-rc.8",
    "@tanstack/solid-start": "2.0.0-rc.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "giscus": "^1.6.0",
    "solid-js": "2.0.0-rc.13"
  },
  "devDependencies": {
    "@ariakit/react": "^0.4.40",
    "@cloudflare/vite-plugin": "1.62.5",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/colorized-brackets": "^4.5.0",
    "@shikijs/rehype": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "@shikijs/twoslash": "^4.5.0",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "bun-types": "^1.4.2",
    "concurrently": "^10.0.5",
    "eslint-plugin-solid": "^0.18.1",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "katex": "^0.16.47",
    "lexical": "0.12.6",
    "lz-string": "^1.5.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-mdx-import-media": "^1.4.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.2",
    "watch": "^1.0.2",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "@solidjs/babel-plugin": "2.0.0-rc.13",
    "@solidjs/compiler": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "solid-js": "2.0.0-rc.13"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@tanstack/solid-start@2.0.0-rc.8": "patches/@tanstack%2Fsolid-start@2.0.0-rc.8.patch",
    "@tanstack/solid-start-client@2.0.0-rc.8": "patches/@tanstack%2Fsolid-start-client@2.0.0-rc.8.patch",
    "@tanstack/solid-router@2.0.0-rc.8": "patches/@tanstack%2Fsolid-router@2.0.0-rc.8.patch"
  }
}
