{
  "name": "dio.la",
  "type": "module",
  "scripts": {
    "gen:article-data": "bun src/scripts/generate-article-data.ts",
    "gen": "bun gen:article-data",
    "watch:article-data": "watch 'bun gen:article-data' src/routes/article",
    "watch": "bun watch:article-data",
    "dev:watch": "NODE_ENV='development' bun watch",
    "dev:solid-start": "solid-start dev",
    "dev": "concurrently --kill-others 'bun dev:watch' 'bun dev:solid-start'",
    "typecheck": "NODE_ENV=development bun run gen && tsc --noEmit --skipLibCheck",
    "lint": "oxlint --ignore-path .gitignore .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "build": "NODE_ENV=production bun gen && solid-start build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare bun run build",
    "preview:cloudflare": "wrangler pages dev dist/public",
    "deploy:cloudflare": "bun run build:cloudflare && wrangler pages deploy dist/public --project-name dio-la",
    "start": "solid-start start",
    "prod": "bun build && bun start"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.7",
    "@solidjs/meta": "^0.29.1",
    "@solidjs/router": "^0.9.1",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "giscus": "^1.3.0",
    "p-debounce": "^4.0.0",
    "solid-js": "^1.8.5",
    "solid-start": "^0.3.10"
  },
  "devDependencies": {
    "@fec/remark-a11y-emoji": "^4.0.0",
    "@mdx-js/mdx": "^3.0.0",
    "@mdx-js/rollup": "^3.0.0",
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.37",
    "autoprefixer": "^10.4.16",
    "bun-types": "^1.0.11",
    "concurrently": "^8.2.2",
    "eslint-plugin-solid": "^0.18.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.9",
    "lexical": "^0.12.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.4.31",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-mdx-images": "^2.0.0",
    "remark-shiki-twoslash": "^3.1.3",
    "rollup": "^4.4.1",
    "sass": "^1.69.5",
    "solid-devtools": "^0.28.1",
    "solid-mdx": "^0.0.7",
    "solid-start-bun": "^0.3.10",
    "solid-start-cloudflare-pages": "0.3.10",
    "solid-start-vercel": "^0.3.10",
    "tailwindcss": "^3.3.5",
    "typescript": "5.2.2",
    "undici": "^5.27.2",
    "vite": "^4.5.0",
    "watch": "^1.0.2",
    "wrangler": "^4.147.0",
    "yaml": "^2.3.4"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "pnpm": {
    "patchedDependencies": {
      "shiki-twoslash@3.1.1": "patches/shiki-twoslash@3.1.1.patch"
    }
  }
}
